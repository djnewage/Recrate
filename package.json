{
  "name": "recrate",
  "version": "1.5.3",
  "description": "Recrate - Stream your Serato music library to mobile devices",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @recrate/server",
    "dev:mobile": "npm run start -w @recrate/mobile",
    "dev:desktop": "npm run dev -w @recrate/desktop",
    "dev:website": "npm run dev -w @recrate/website",
    "start:server": "npm run start -w @recrate/server",
    "start:mobile": "npm run start -w @recrate/mobile",
    "start:desktop": "npm run start -w @recrate/desktop",
    "build": "npm run build -w @recrate/website",
    "build:server": "npm run build -w @recrate/server",
    "build:desktop": "npm run build -w @recrate/desktop",
    "build:website": "npm run build -w @recrate/website",
    "preview:website": "npm run preview -w @recrate/website",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rm -rf node_modules packages/*/node_modules"
  },
  "keywords": [
    "serato",
    "dj",
    "music",
    "streaming",
    "crates",
    "react-native",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^8.2.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
