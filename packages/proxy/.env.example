# Proxy Configuration
PORT=3001
NODE_ENV=production

# --- Required in production (boot fails if missing; see src/utils/validateEnv.js) ---

# Central Anthropic key the /api/llm/complete endpoint spends on behalf of entitled users
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# RevenueCat webhook authorization (Bearer token configured in the RevenueCat dashboard)
REVENUECAT_WEBHOOK_AUTH_KEY=

# CORS allowlist — comma-separated origins allowed to call the API from a browser.
# Native mobile/desktop clients send no Origin and are unaffected. Required in prod;
# if unset, CORS is permissive (dev only).
ALLOWED_ORIGINS=https://recrate.app,https://www.recrate.app

# Firebase / Firestore (subscription source of truth + ID-token verification)
FIREBASE_PROJECT_ID=
# Provide EITHER the service-account JSON inline...
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...OR a path to a credentials file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Optional (warn-only) ---

# Sentry error tracking (enabled in production)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# GA4 Measurement Protocol (server-side analytics)
# GA4_MEASUREMENT_ID=
# GA4_API_SECRET=

# Redis (optional, for multi-instance rate limiting / scaling)
# REDIS_URL=redis://localhost:6379
