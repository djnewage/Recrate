{
  "expo": {
    "name": "Recrate",
    "slug": "recrate",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/officialLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": [
      "recrate",
      "com.googleusercontent.apps.666443636006-v6gcsq168r0lpkmlehq0tmg6hfdfv4cd"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recrate.app",
      "buildNumber": "9",
      "infoPlist": {
        "NSCameraUsageDescription": "Recrate needs camera access to scan QR codes for connecting to your server.",
        "NSLocalNetworkUsageDescription": "Recrate needs local network access to connect to your music server on your home network.",
        "NSMicrophoneUsageDescription": "Recrate uses the microphone to identify songs playing around you by capturing a short audio sample.",
        "NSLocationWhenInUseUsageDescription": "Recrate may use your location to improve service quality and analytics.",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.vpn.api": [
          "allow-vpn"
        ],
        "com.apple.developer.networking.networkextension": [
          "app-proxy-provider",
          "packet-tunnel-provider"
        ],
        "com.apple.developer.networking.multipath": true,
        "com.apple.developer.applesignin": ["Default"]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "permissions": [
        "CAMERA",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.recrate.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "99558d9b-96b2-4206-963e-38a26a0bb971"
      }
    },
    "owner": "djnewage",
    "plugins": [
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "recrate-llc",
          "project": "recrate-mobile"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.666443636006-v6gcsq168r0lpkmlehq0tmg6hfdfv4cd"
        }
      ],
      "./plugins/withFirebaseFix"
    ],
    "hooks": {
      "postPublish": [
        {
          "file": "@sentry/react-native/expo",
          "config": {
            "organization": "recrate-llc",
            "project": "recrate-mobile"
          }
        }
      ]
    }
  }
}
